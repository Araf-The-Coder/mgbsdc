{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && nvm use 20 >/dev/null && npm run dev -- --host 0.0.0.0 --port 4173",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "severity": "info",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        }
      }
    }
  ]
}
